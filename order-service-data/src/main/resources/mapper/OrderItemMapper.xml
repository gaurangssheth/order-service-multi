<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.orderservice.mapper.OrderItemMapper">

    <resultMap id="OrderItemJoinResultMap" type="com.example.orderservice.model.OrderItem">
        <id property="id"
            column="item_id"
            typeHandler="com.example.orderservice.typehandler.UUIDTypeHandler"/>

        <result property="orderId"
                column="order_id"
                typeHandler="com.example.orderservice.typehandler.UUIDTypeHandler"/>

        <result property="productCode" column="product_code"/>
        <result property="quantity" column="quantity"/>
        <result property="unitPrice" column="unit_price"/>
    </resultMap>

    <resultMap id="OrderItemResultMap" type="com.example.orderservice.model.OrderItem">
        <id property="id"
            column="id"
            typeHandler="com.example.orderservice.typehandler.UUIDTypeHandler"/>

        <result property="orderId"
                column="order_id"
                typeHandler="com.example.orderservice.typehandler.UUIDTypeHandler"/>

        <result property="productCode" column="product_code"/>
        <result property="quantity" column="quantity"/>
        <result property="unitPrice" column="unit_price"/>
    </resultMap>

    <insert id="insertOrderItem">
        INSERT INTO order_items (
        id,
        order_id,
        product_code,
        quantity,
        unit_price
        )
        VALUES (
        #{item.id,typeHandler=com.example.orderservice.typehandler.UUIDTypeHandler},
        #{item.orderId,typeHandler=com.example.orderservice.typehandler.UUIDTypeHandler},
        #{item.productCode},
        #{item.quantity},
        #{item.unitPrice}
        )
    </insert>

    <select id="findByOrderId" resultMap="OrderItemResultMap">
        SELECT
        id,
        order_id,
        product_code,
        quantity,
        unit_price
        FROM order_items
        WHERE order_id = #{orderId,typeHandler=com.example.orderservice.typehandler.UUIDTypeHandler}
    </select>

</mapper>